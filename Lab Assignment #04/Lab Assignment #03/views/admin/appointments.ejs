<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="Manage all worker bookings and appointments.">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/booking.css">
</head>
<body>

<%- include('../partials/adminNavbar') %>
<%- include('../partials/flash') %>

<div class="admin-wrapper">

    <%- include('../partials/adminSidebar', { activePage: 'appointments' }) %>

    <main class="admin-main">

        <header class="admin-header">
            <div>
                <h1 class="admin-page-title">Appointments</h1>
                <p class="admin-page-sub">Manage all customer bookings — <strong><%= bookings.length %></strong> total.</p>
            </div>
        </header>

        <section class="admin-table-section">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Worker</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Hours</th>
                            <th>Total</th>
                            <th>Notes</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (bookings.length === 0) { %>
                            <tr>
                                <td colspan="10" class="table-empty">No appointments yet.</td>
                            </tr>
                        <% } %>
                        <% bookings.forEach(function(b, i) { %>
                            <tr>
                                <td class="table-num"><%= i + 1 %></td>
                                <td>
                                    <span class="table-name"><%= b.customerName %></span>
                                    <br><small style="color:var(--text-muted);font-size:.75rem"><%= b.customerEmail %></small>
                                </td>
                                <td class="table-name"><%= b.workerName %></td>
                                <td><span class="table-category-badge"><%= b.workerCategory %></span></td>
                                <td><%= new Date(b.bookingDate).toLocaleDateString('en-PK', { year:'numeric', month:'short', day:'numeric' }) %></td>
                                <td><%= b.hours %>h</td>
                                <td class="table-price">PKR <%= b.totalAmount.toLocaleString() %></td>
                                <td style="max-width:140px;font-size:.8rem;color:var(--text-muted)">
                                    <%= b.notes && b.notes.trim() ? b.notes.slice(0,60) + (b.notes.length > 60 ? '…' : '') : '—' %>
                                </td>
                                <td>
                                    <span class="appt-badge appt-badge--<%= b.status %>"><%= b.status %></span>
                                </td>
                                <td class="table-actions">
                                    <!-- Status Update Form -->
                                    <form method="POST" action="/admin/appointments/<%= b._id %>/status" style="display:inline">
                                        <select name="status" class="appt-status-select" onchange="this.form.submit()" title="Change status">
                                            <% ['pending','confirmed','in-progress','completed','cancelled','rejected'].forEach(function(s) { %>
                                                <option value="<%= s %>" <%= b.status === s ? 'selected' : '' %>><%= s %></option>
                                            <% }); %>
                                        </select>
                                    </form>
                                    <!-- Delete Button -->
                                    <button
                                        class="btn-tbl-delete"
                                        title="Delete appointment"
                                        onclick="openApptDeleteModal('<%= b._id %>', '<%= b.workerName.replace(/'/g, "\\'") %>', '<%= b.customerName.replace(/'/g, "\\'") %>')"
                                    >
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

<!-- ═══ DELETE CONFIRMATION MODAL ═══ -->
<div id="appt-delete-overlay" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="appt-modal-title">
    <div class="modal-box">
        <div class="modal-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
        </div>
        <h2 class="modal-title" id="appt-modal-title">Delete Appointment?</h2>
        <p class="modal-desc">
            Delete booking of <strong id="appt-modal-worker"></strong> for <strong id="appt-modal-customer"></strong>? This cannot be undone.
        </p>
        <div class="modal-actions">
            <button class="btn-modal-cancel" id="appt-cancel-btn" onclick="closeApptDeleteModal()">Cancel</button>
            <form id="appt-delete-form" method="POST" action="" style="display:inline">
                <button type="submit" class="btn-modal-confirm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                    Yes, Delete
                </button>
            </form>
        </div>
    </div>
</div>

<script src="/js/navbar.js"></script>
<script>
const apptOverlay  = document.getElementById('appt-delete-overlay');
const apptWorkerEl = document.getElementById('appt-modal-worker');
const apptCustEl   = document.getElementById('appt-modal-customer');
const apptForm     = document.getElementById('appt-delete-form');

function openApptDeleteModal(id, workerName, customerName) {
    apptWorkerEl.textContent   = workerName;
    apptCustEl.textContent     = customerName;
    apptForm.action = `/admin/appointments/${id}/delete`;
    apptOverlay.classList.add('modal-visible');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('appt-cancel-btn').focus(), 100);
}
function closeApptDeleteModal() {
    apptOverlay.classList.remove('modal-visible');
    document.body.style.overflow = '';
}
apptOverlay.addEventListener('click', function(e) {
    if (e.target === apptOverlay) closeApptDeleteModal();
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && apptOverlay.classList.contains('modal-visible')) closeApptDeleteModal();
});
</script>
</body>
</html>
