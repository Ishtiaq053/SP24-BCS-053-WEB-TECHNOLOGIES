<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard — WorkerFinder</title>
    <meta name="description" content="WorkerFinder admin control panel — overview and statistics.">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/booking.css">
</head>
<body>

<%- include('../partials/adminNavbar') %>
<%- include('../partials/flash') %>

<div class="admin-wrapper">

    <%- include('../partials/adminSidebar', { activePage: 'dashboard' }) %>

    <!-- ── Main Content ── -->
    <main class="admin-main">

        <header class="admin-header">
            <div>
                <h1 class="admin-page-title">Dashboard</h1>
                <p class="admin-page-sub">Welcome back, <strong><%= currentUser.name %></strong> — here's your overview.</p>
            </div>
        </header>

        <!-- ── Stat Cards ── -->
        <div class="admin-stats-grid">

            <div class="stat-card stat-card--blue">
                <div class="stat-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div class="stat-card-body">
                    <p class="stat-card-label">Total Workers</p>
                    <p class="stat-card-value"><%= totalWorkers %></p>
                </div>
            </div>

            <div class="stat-card stat-card--green">
                <div class="stat-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div class="stat-card-body">
                    <p class="stat-card-label">Available</p>
                    <p class="stat-card-value"><%= availableWorkers %></p>
                </div>
            </div>

            <div class="stat-card stat-card--orange">
                <div class="stat-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
                <div class="stat-card-body">
                    <p class="stat-card-label">Busy</p>
                    <p class="stat-card-value"><%= busyWorkers %></p>
                </div>
            </div>

            <div class="stat-card stat-card--purple">
                <div class="stat-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <div class="stat-card-body">
                    <p class="stat-card-label">Registered Users</p>
                    <p class="stat-card-value"><%= totalUsers %></p>
                </div>
            </div>

            <div class="stat-card stat-card--teal">
                <div class="stat-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="stat-card-body">
                    <p class="stat-card-label">Total Appointments</p>
                    <p class="stat-card-value"><%= typeof totalAppointments !== 'undefined' ? totalAppointments : 0 %></p>
                </div>
            </div>

        </div>

        <!-- ── Secondary Stats Row (no Quick Actions) ── -->
        <div class="admin-stats-secondary">
            <div class="stat-mini">
                <span class="stat-mini-label">Verified Workers</span>
                <span class="stat-mini-value verified-color"><%= typeof verifiedWorkers !== 'undefined' ? verifiedWorkers : '—' %></span>
            </div>
            <div class="stat-mini">
                <span class="stat-mini-label">Availability Rate</span>
                <span class="stat-mini-value">
                    <%= totalWorkers > 0 ? Math.round((availableWorkers / totalWorkers) * 100) : 0 %>%
                </span>
            </div>
            <div class="stat-mini">
                <span class="stat-mini-label">Busy Rate</span>
                <span class="stat-mini-value">
                    <%= totalWorkers > 0 ? Math.round((busyWorkers / totalWorkers) * 100) : 0 %>%
                </span>
            </div>
        </div>

        <!-- ── Recent Workers Table ── -->
        <section class="admin-table-section">
            <div class="admin-table-header">
                <h2 class="admin-table-title">Recent Workers</h2>
                <a href="/admin/workers" class="btn-admin-view-all">Manage All Workers →</a>
            </div>

            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Rate / hr</th>
                            <th>Rating</th>
                            <th>Status</th>
                            <th>Verified</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentWorkers.length === 0) { %>
                            <tr>
                                <td colspan="10" class="table-empty">No workers found. <a href="/admin/workers/add" style="color:var(--green)">Add one now →</a></td>
                            </tr>
                        <% } %>
                        <% recentWorkers.forEach(function(worker, i) { %>
                            <tr>
                                <td class="table-num"><%= i + 1 %></td>
                                <td>
                                    <img
                                        src="<%= worker.image || '/images/avatar-placeholder.png' %>"
                                        alt="<%= worker.name %>"
                                        class="table-thumb"
                                        onerror="this.src='/images/avatar-placeholder.png'"
                                    >
                                </td>
                                <td class="table-name"><%= worker.name %></td>
                                <td><span class="table-category-badge"><%= worker.category %></span></td>
                                <td><%= worker.location %></td>
                                <td class="table-price">PKR <%= worker.price.toLocaleString() %></td>
                                <td><span class="table-rating">★ <%= worker.rating.toFixed(1) %></span></td>
                                <td>
                                    <% if (worker.stock === 1) { %>
                                        <span class="status-badge status-badge--available">Available</span>
                                    <% } else { %>
                                        <span class="status-badge status-badge--busy">Busy</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (worker.verified) { %>
                                        <span class="verified-tick">✓</span>
                                    <% } else { %>
                                        <span class="unverified-dash">–</span>
                                    <% } %>
                                </td>
                                <td class="table-actions">
                                    <a href="/admin/workers/edit/<%= worker._id %>" class="btn-tbl-edit" title="Edit worker">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        Edit
                                    </a>
                                    <button
                                        class="btn-tbl-delete"
                                        title="Delete worker"
                                        onclick="openDeleteModal('<%= worker._id %>', '<%= worker.name.replace(/'/g, '\\\'') %>')"
                                    >
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ── Recent Appointments Widget ── -->
        <section class="admin-table-section" style="margin-top:2rem">
            <div class="admin-table-header">
                <h2 class="admin-table-title">Recent Appointments</h2>
                <a href="/admin/appointments" class="btn-admin-view-all">Manage All →</a>
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Worker</th>
                            <th>Category</th>
                            <th>Date</th>
                            <th>Hours</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!recentBookings || recentBookings.length === 0) { %>
                            <tr><td colspan="8" class="table-empty">No appointments yet. <a href="/workers" style="color:var(--green)">Browse workers →</a></td></tr>
                        <% } %>
                        <% (recentBookings || []).forEach(function(b, i) { %>
                            <tr>
                                <td class="table-num"><%= i + 1 %></td>
                                <td class="table-name"><%= b.customerName %></td>
                                <td class="table-name"><%= b.workerName %></td>
                                <td><span class="table-category-badge"><%= b.workerCategory %></span></td>
                                <td><%= new Date(b.bookingDate).toLocaleDateString('en-PK') %></td>
                                <td><%= b.hours %>h</td>
                                <td class="table-price">PKR <%= b.totalAmount.toLocaleString() %></td>
                                <td><span class="appt-badge appt-badge--<%= b.status %>"><%= b.status %></span></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

<!-- ═══ DELETE CONFIRMATION MODAL ═══ -->
<div id="delete-modal-overlay" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box" id="delete-modal-box">
        <div class="modal-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        </div>
        <h2 class="modal-title" id="modal-title">Delete Worker?</h2>
        <p class="modal-desc">
            You are about to permanently delete
            <strong id="modal-worker-name">this worker</strong>.
            This action cannot be undone.
        </p>
        <div class="modal-actions">
            <button class="btn-modal-cancel" id="modal-cancel-btn" onclick="closeDeleteModal()">Cancel</button>
            <form id="delete-form" method="POST" action="" style="display:inline">
                <button type="submit" class="btn-modal-confirm">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                    Yes, Delete
                </button>
            </form>
        </div>
    </div>
</div>

<script src="/js/navbar.js"></script>
<script>
const overlay  = document.getElementById('delete-modal-overlay');
const nameEl   = document.getElementById('modal-worker-name');
const form     = document.getElementById('delete-form');

function openDeleteModal(id, name) {
    nameEl.textContent = name;
    form.action = `/admin/workers/delete/${id}`;
    overlay.classList.add('modal-visible');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('modal-cancel-btn').focus(), 100);
}
function closeDeleteModal() {
    overlay.classList.remove('modal-visible');
    document.body.style.overflow = '';
}
overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closeDeleteModal();
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.classList.contains('modal-visible')) closeDeleteModal();
});
</script>
</body>
</html>
