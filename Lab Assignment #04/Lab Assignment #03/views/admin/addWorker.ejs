<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Worker — WorkerFinder</title>
    <meta name="description" content="Admin panel — add a new worker to WorkerFinder.">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('../partials/adminNavbar') %>
<%- include('../partials/flash') %>

<div class="admin-wrapper">

    <%- include('../partials/adminSidebar', { activePage: 'add' }) %>

    <main class="admin-main">

        <header class="admin-header">
            <div>
                <h1 class="admin-page-title">Add New Worker</h1>
                <p class="admin-page-sub">Fill in the details below to register a new worker.</p>
            </div>
            <a href="/admin/workers" class="btn-admin-back">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                Back to Workers
            </a>
        </header>

        <!-- ── Form Card ── -->
        <div class="admin-form-card">

            <form
                id="add-worker-form"
                action="/admin/workers/add"
                method="POST"
                enctype="multipart/form-data"
                novalidate
            >

                <!-- ── Image Upload ── -->
                <div class="form-section">
                    <h3 class="form-section-title">Worker Photo</h3>
                    <div class="img-upload-area" id="img-upload-area">
                        <div class="img-preview-wrap" id="img-preview-wrap">
                            <img id="img-preview" src="" alt="" class="img-preview hidden">
                            <div class="img-upload-placeholder" id="img-placeholder">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                <p>Click or drag to upload photo</p>
                                <span>JPG, PNG, WebP — max 5 MB</span>
                            </div>
                        </div>
                        <input type="file" id="image" name="image" accept=".jpg,.jpeg,.png,.webp" class="img-file-input">
                        <div id="img-error" class="field-error hidden">Invalid image. Only JPG, PNG, WebP up to 5 MB.</div>
                    </div>
                </div>

                <!-- ── Basic Info ── -->
                <div class="form-section">
                    <h3 class="form-section-title">Basic Information</h3>
                    <div class="form-grid-2">

                        <!-- Name -->
                        <div class="admin-form-group">
                            <label for="name" class="admin-form-label">Full Name <span class="req">*</span></label>
                            <input
                                type="text"
                                id="name"
                                name="name"
                                class="admin-form-input <%= errors.name ? 'input-error' : '' %>"
                                placeholder="e.g. Muhammad Ali"
                                value="<%= old.name || '' %>"
                                maxlength="80"
                            >
                            <% if (errors.name) { %><span class="field-error"><%= errors.name %></span><% } %>
                        </div>

                        <!-- Category -->
                        <div class="admin-form-group">
                            <label for="category" class="admin-form-label">Category <span class="req">*</span></label>
                            <select id="category" name="category" class="admin-form-input admin-form-select <%= errors.category ? 'input-error' : '' %>">
                                <option value="">— Select Category —</option>
                                <% categories.forEach(function(cat) { %>
                                    <option value="<%= cat %>" <%= (old.category === cat) ? 'selected' : '' %>><%= cat %></option>
                                <% }); %>
                            </select>
                            <% if (errors.category) { %><span class="field-error"><%= errors.category %></span><% } %>
                        </div>

                        <!-- Price -->
                        <div class="admin-form-group">
                            <label for="price" class="admin-form-label">Hourly Rate (PKR) <span class="req">*</span></label>
                            <input
                                type="number"
                                id="price"
                                name="price"
                                class="admin-form-input <%= errors.price ? 'input-error' : '' %>"
                                placeholder="e.g. 500"
                                value="<%= old.price || '' %>"
                                min="0"
                            >
                            <% if (errors.price) { %><span class="field-error"><%= errors.price %></span><% } %>
                        </div>

                        <!-- Rating -->
                        <div class="admin-form-group">
                            <label for="rating" class="admin-form-label">Rating (1–5)</label>
                            <input
                                type="number"
                                id="rating"
                                name="rating"
                                class="admin-form-input <%= errors.rating ? 'input-error' : '' %>"
                                placeholder="e.g. 4.5"
                                value="<%= old.rating || '3' %>"
                                min="1" max="5" step="0.1"
                            >
                            <% if (errors.rating) { %><span class="field-error"><%= errors.rating %></span><% } %>
                        </div>

                        <!-- Location -->
                        <div class="admin-form-group">
                            <label for="location" class="admin-form-label">Location</label>
                            <input
                                type="text"
                                id="location"
                                name="location"
                                class="admin-form-input"
                                placeholder="e.g. Lahore"
                                value="<%= old.location || 'Lahore' %>"
                                maxlength="60"
                            >
                        </div>

                        <!-- Experience -->
                        <div class="admin-form-group">
                            <label for="experience" class="admin-form-label">Experience (years)</label>
                            <input
                                type="number"
                                id="experience"
                                name="experience"
                                class="admin-form-input"
                                placeholder="e.g. 5"
                                value="<%= old.experience || '0' %>"
                                min="0" max="50"
                            >
                        </div>

                        <!-- Jobs Done -->
                        <div class="admin-form-group">
                            <label for="jobsDone" class="admin-form-label">Jobs Done</label>
                            <input
                                type="number"
                                id="jobsDone"
                                name="jobsDone"
                                class="admin-form-input"
                                placeholder="e.g. 120"
                                value="<%= old.jobsDone || '0' %>"
                                min="0"
                            >
                        </div>

                        <!-- Availability -->
                        <div class="admin-form-group">
                            <label for="stock" class="admin-form-label">Availability</label>
                            <select id="stock" name="stock" class="admin-form-input admin-form-select">
                                <option value="1" <%= (old.stock === '1' || !old.stock) ? 'selected' : '' %>>Available</option>
                                <option value="0" <%= old.stock === '0' ? 'selected' : '' %>>Busy</option>
                            </select>
                        </div>

                        <!-- Verified -->
                        <div class="admin-form-group">
                            <label for="verified" class="admin-form-label">Verified Status</label>
                            <select id="verified" name="verified" class="admin-form-input admin-form-select">
                                <option value="false" <%= (old.verified === 'false' || !old.verified) ? 'selected' : '' %>>Not Verified</option>
                                <option value="true"  <%= old.verified === 'true' ? 'selected' : '' %>>Verified ✓</option>
                            </select>
                        </div>

                    </div>
                </div>

                <!-- ── Description ── -->
                <div class="form-section">
                    <h3 class="form-section-title">Description</h3>
                    <div class="admin-form-group">
                        <label for="description" class="admin-form-label">Bio / Skills Summary</label>
                        <textarea
                            id="description"
                            name="description"
                            class="admin-form-input admin-form-textarea"
                            placeholder="Describe the worker's expertise, skills, and experience..."
                            rows="4"
                            maxlength="600"
                        ><%= old.description || '' %></textarea>
                        <span class="char-count" id="desc-count">0 / 600</span>
                    </div>
                </div>

                <!-- ── Form Actions ── -->
                <div class="form-actions">
                    <a href="/admin/workers" class="btn-form-cancel">Cancel</a>
                    <button type="submit" class="btn-form-submit" id="submit-btn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                        Add Worker
                    </button>
                </div>

            </form>
        </div>

    </main>
</div>

<script src="/js/navbar.js"></script>
<script>
/* ── Image Preview ─────────────────────────────────── */
const fileInput   = document.getElementById('image');
const preview     = document.getElementById('img-preview');
const placeholder = document.getElementById('img-placeholder');
const imgError    = document.getElementById('img-error');
const uploadArea  = document.getElementById('img-upload-area');

function handleFile(file) {
    if (!file) return;
    const allowed = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
    if (!allowed.includes(file.type)) {
        imgError.classList.remove('hidden');
        fileInput.value = '';
        return;
    }
    if (file.size > 5 * 1024 * 1024) {
        imgError.textContent = 'File too large. Maximum size is 5 MB.';
        imgError.classList.remove('hidden');
        fileInput.value = '';
        return;
    }
    imgError.classList.add('hidden');
    const reader = new FileReader();
    reader.onload = function(e) {
        preview.src = e.target.result;
        preview.classList.remove('hidden');
        placeholder.style.display = 'none';
    };
    reader.readAsDataURL(file);
}

uploadArea.addEventListener('click', () => fileInput.click());

uploadArea.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadArea.classList.add('drag-over');
});
uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
uploadArea.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadArea.classList.remove('drag-over');
    if (e.dataTransfer.files[0]) {
        fileInput.files = e.dataTransfer.files;
        handleFile(e.dataTransfer.files[0]);
    }
});

fileInput.addEventListener('change', () => handleFile(fileInput.files[0]));

/* ── Char counter ─────────────────────────────────── */
const desc      = document.getElementById('description');
const descCount = document.getElementById('desc-count');
desc.addEventListener('input', () => {
    descCount.textContent = `${desc.value.length} / 600`;
});
descCount.textContent = `${desc.value.length} / 600`;

/* ── Client-side Validation ───────────────────────── */
const form = document.getElementById('add-worker-form');

form.addEventListener('submit', function(e) {
    let valid = true;

    // Name
    const name = document.getElementById('name');
    const nameErr = name.nextElementSibling;
    if (!name.value.trim()) {
        showError(name, 'Name is required.');
        valid = false;
    } else {
        clearError(name);
    }

    // Category
    const cat = document.getElementById('category');
    if (!cat.value) {
        showError(cat, 'Please select a category.');
        valid = false;
    } else {
        clearError(cat);
    }

    // Price
    const price = document.getElementById('price');
    if (!price.value || isNaN(price.value) || Number(price.value) < 0) {
        showError(price, 'Enter a valid positive price.');
        valid = false;
    } else {
        clearError(price);
    }

    // Rating
    const rating = document.getElementById('rating');
    if (rating.value && (Number(rating.value) < 1 || Number(rating.value) > 5)) {
        showError(rating, 'Rating must be between 1 and 5.');
        valid = false;
    } else {
        clearError(rating);
    }

    if (!valid) e.preventDefault();
});

function showError(input, msg) {
    input.classList.add('input-error');
    let err = input.parentElement.querySelector('.field-error');
    if (!err) {
        err = document.createElement('span');
        err.className = 'field-error';
        input.parentElement.appendChild(err);
    }
    err.textContent = msg;
    err.classList.remove('hidden');
}

function clearError(input) {
    input.classList.remove('input-error');
    const err = input.parentElement.querySelector('.field-error');
    if (err) err.textContent = '';
}
</script>
</body>
</html>
