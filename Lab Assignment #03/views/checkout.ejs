<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout — WorkerFinder</title>
    <meta name="description" content="Proceed to hire your chosen skilled worker on WorkerFinder.">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<main class="checkout-main">
    <div class="checkout-card">
        <div class="checkout-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </div>
        <h1 class="checkout-title">Confirm Booking</h1>
        <p class="checkout-desc">
            Logged in as <strong><%= currentUser.name %></strong>.
        </p>

        <% if (typeof worker !== 'undefined' && worker) { %>
        <!-- Worker summary if coming from a specific profile -->
        <div class="checkout-worker-summary">
            <img
                src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(worker.name) %>&background=random&size=64&bold=true&color=fff"
                alt="<%= worker.name %>"
                class="checkout-worker-avatar"
            >
            <div class="checkout-worker-info">
                <p class="checkout-worker-name"><%= worker.name %></p>
                <p class="checkout-worker-cat"><%= worker.category %></p>
                <p class="checkout-worker-rate">PKR <%= worker.price.toLocaleString() %>/hr</p>
            </div>
        </div>
        <% } %>

        <div class="checkout-info-box">
            <p>🚀 <strong>Coming Soon:</strong> Full booking and payment flow will be implemented here.</p>
            <ul>
                <li>Select a worker from the catalog</li>
                <li>Choose date &amp; time slot</li>
                <li>Confirm your booking</li>
                <li>Pay securely online</li>
            </ul>
        </div>
        <div class="checkout-actions">
            <a href="/workers" class="btn-checkout-primary">Browse Workers</a>
            <a href="/"        class="btn-checkout-secondary">Back to Home</a>
        </div>
    </div>
</main>

<script src="/js/navbar.js"></script>
</body>
</html>
