<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find Workers — WorkerFinder</title>
    <meta name="description" content="Browse and hire verified skilled workers near you. Filter by category, price, and rating.">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- ═══ NAVBAR ═══ -->
<%- include('partials/navbar') %>
<%- include('partials/flash') %>

<!-- ═══ WORKERS HERO BANNER ═══ -->
<section class="workers-hero">
    <div class="workers-hero-overlay"></div>
    <div class="workers-hero-content">
        <h1 class="workers-hero-title">Find Your Worker</h1>
        <p class="workers-hero-sub">Browse <%= totalWorkers %> verified professionals across <%= categories.length %> skilled trades</p>
    </div>
</section>

<!-- ═══ FILTER BAR ═══ -->
<section class="filter-section">
    <div class="container">
        <form method="GET" action="/workers" class="filter-bar" id="filterForm">

            <!-- Search -->
            <div class="filter-group">
                <label for="search" class="filter-label">Search</label>
                <input
                    type="text"
                    id="search"
                    name="search"
                    class="filter-input"
                    placeholder="Worker name…"
                    value="<%= search %>"
                >
            </div>

            <!-- Category -->
            <div class="filter-group">
                <label for="category" class="filter-label">Category</label>
                <select id="category" name="category" class="filter-select">
                    <option value="">All Categories</option>
                    <% categories.forEach(function(cat) { %>
                        <option value="<%= cat %>" <%= category === cat ? 'selected' : '' %>>
                            <%= cat %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <!-- Min Price -->
            <div class="filter-group filter-group--sm">
                <label for="minPrice" class="filter-label">Min Price</label>
                <input
                    type="number"
                    id="minPrice"
                    name="minPrice"
                    class="filter-input"
                    placeholder="PKR"
                    value="<%= minPrice %>"
                    min="0"
                >
            </div>

            <!-- Max Price -->
            <div class="filter-group filter-group--sm">
                <label for="maxPrice" class="filter-label">Max Price</label>
                <input
                    type="number"
                    id="maxPrice"
                    name="maxPrice"
                    class="filter-input"
                    placeholder="PKR"
                    value="<%= maxPrice %>"
                    min="0"
                >
            </div>

            <!-- Sort -->
            <div class="filter-group">
                <label for="sort" class="filter-label">Sort By</label>
                <select id="sort" name="sort" class="filter-select">
                    <option value="">Newest First</option>
                    <option value="price_asc"       <%= sort === 'price_asc'       ? 'selected' : '' %>>Price: Low → High</option>
                    <option value="price_desc"      <%= sort === 'price_desc'      ? 'selected' : '' %>>Price: High → Low</option>
                    <option value="rating_desc"     <%= sort === 'rating_desc'     ? 'selected' : '' %>>Top Rated</option>
                    <option value="experience_desc" <%= sort === 'experience_desc' ? 'selected' : '' %>>Most Experienced</option>
                </select>
            </div>

            <!-- Buttons -->
            <div class="filter-btns">
                <button type="submit" class="btn-filter-apply">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Apply
                </button>
                <a href="/workers" class="btn-filter-reset">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.1"/></svg>
                    Reset
                </a>
            </div>
        </form>
    </div>
</section>

<!-- ═══ RESULTS INFO BAR ═══ -->
<section class="results-bar-section">
    <div class="container">
        <div class="results-bar">
            <p class="results-info">
                Showing
                <strong><%= workers.length %></strong>
                of
                <strong><%= totalWorkers %></strong>
                worker<%= totalWorkers !== 1 ? 's' : '' %>
                <% if (search || category || minPrice || maxPrice) { %>
                    <span class="results-filter-tag">
                        <% if (category) { %><span class="tag"><%= category %></span><% } %>
                        <% if (search)   { %><span class="tag">"<%= search %>"</span><% } %>
                        <% if (minPrice || maxPrice) { %><span class="tag">PKR <%= minPrice || '0' %> – <%= maxPrice || '∞' %></span><% } %>
                    </span>
                <% } %>
            </p>
            <p class="results-page-info">Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong></p>
        </div>
    </div>
</section>

<!-- ═══ WORKERS GRID ═══ -->
<section class="workers-section">
    <div class="container">

        <% if (workers.length === 0) { %>
            <!-- ── Empty State ── -->
            <div class="empty-state">
                <div class="empty-icon">🔍</div>
                <h2 class="empty-title">No Workers Found</h2>
                <p class="empty-desc">We couldn't find any workers matching your filters. Try adjusting your search criteria.</p>
                <a href="/workers" class="btn-empty-reset">Clear All Filters</a>
            </div>

        <% } else { %>
            <!-- ── Workers Grid ── -->
            <div class="workers-grid">
                <% workers.forEach(function(worker) { %>

                    <%
                        // Category emoji map
                        const emojiMap = {
                            'Plumbing':    '🔧',
                            'Electrical':  '⚡',
                            'Carpentry':   '🪚',
                            'Painting':    '🎨',
                            'Cleaning':    '🧹',
                            'Driving':     '🚗',
                            'Gardening':   '🌿',
                            'AC & Repair': '❄️'
                        };
                        const emoji = emojiMap[worker.category] || '🛠️';
                        const isAvailable = worker.stock === 1;
                        const fullStars  = Math.floor(worker.rating);
                        const halfStar   = (worker.rating - fullStars) >= 0.5;
                    %>

                    <div class="worker-card">
                        <!-- Top Section: Avatar + Verified Badge -->
                        <div class="worker-card-top">
                            <div class="worker-avatar-wrap">
                                <img
                                    src="<%= worker.image && worker.image.trim() !== '' ? worker.image : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(worker.name) + '&background=random&size=80&bold=true&color=fff' %>"
                                    alt="<%= worker.name %>"
                                    class="worker-avatar"
                                    loading="lazy"
                                    onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(worker.name) %>&background=random&size=80&bold=true&color=fff'"
                                >
                            </div>
                            <% if (worker.verified) { %>
                                <span class="verified-badge" title="Verified Worker">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                                    Verified
                                </span>
                            <% } %>
                            <span class="availability-badge <%= isAvailable ? 'badge--available' : 'badge--busy' %>">
                                <span class="badge-dot"></span>
                                <%= isAvailable ? 'Available' : 'Busy' %>
                            </span>
                        </div>

                        <!-- Worker Info -->
                        <div class="worker-card-body">
                            <h3 class="worker-name"><%= worker.name %></h3>
                            <p class="worker-category"><%= emoji %> <%= worker.category %></p>

                            <!-- Star Rating -->
                            <div class="star-rating" aria-label="Rating: <%= worker.rating %> out of 5">
                                <% for (let i = 1; i <= 5; i++) { %>
                                    <% if (i <= fullStars) { %>
                                        <span class="star star--full">★</span>
                                    <% } else if (i === fullStars + 1 && halfStar) { %>
                                        <span class="star star--half">★</span>
                                    <% } else { %>
                                        <span class="star star--empty">★</span>
                                    <% } %>
                                <% } %>
                                <span class="rating-value"><%= worker.rating.toFixed(1) %></span>
                            </div>

                            <!-- Meta Row -->
                            <div class="worker-meta">
                                <span class="meta-item">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    <%= worker.location %>
                                </span>
                                <span class="meta-item">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                    <%= worker.experience %> yrs exp
                                </span>
                                <span class="meta-item">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                                    <%= worker.jobsDone %> jobs
                                </span>
                            </div>

                            <!-- Description -->
                            <p class="worker-desc"><%= worker.description %></p>
                        </div>

                        <!-- Card Footer: Price + CTA -->
                        <div class="worker-card-footer">
                            <div class="worker-price">
                                <span class="price-amount">PKR <%= worker.price.toLocaleString() %></span>
                                <span class="price-unit">/hr</span>
                            </div>
                            <% if (!isAvailable) { %>
                                <button class="btn-view-profile" disabled title="Currently Busy">
                                    Unavailable
                                </button>
                            <% } else if (currentUser) { %>
                                <a href="/workers/<%= worker._id %>" class="btn-view-profile">
                                    View Profile
                                </a>
                            <% } else { %>
                                <a href="/login" class="btn-view-profile btn-view-profile--guest"
                                   data-worker-id="<%= worker._id %>"
                                   title="Login to view full profile">
                                    View Profile
                                </a>
                            <% } %>
                        </div>
                    </div>

                <% }); %>
            </div><!-- /.workers-grid -->
        <% } %>

    </div>
</section>

<!-- ═══ PAGINATION ═══ -->
<% if (totalPages > 1) { %>
<section class="pagination-section">
    <div class="container">
        <nav class="pagination" aria-label="Page navigation">

            <%
                // Build query string preserving all current filters
                function buildPageUrl(p) {
                    const params = new URLSearchParams();
                    if (search)   params.set('search',   search);
                    if (category) params.set('category', category);
                    if (minPrice) params.set('minPrice', minPrice);
                    if (maxPrice) params.set('maxPrice', maxPrice);
                    if (sort)     params.set('sort',     sort);
                    params.set('page', p);
                    return '/workers?' + params.toString();
                }
            %>

            <!-- Previous Button -->
            <% if (currentPage <= 1) { %>
                <span class="page-btn page-btn--disabled" aria-disabled="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
                    Prev
                </span>
            <% } else { %>
                <a href="<%= buildPageUrl(currentPage - 1) %>" class="page-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
                    Prev
                </a>
            <% } %>

            <!-- Page Number Buttons -->
            <%
                const VISIBLE_PAGES = 5;
                let startPage = Math.max(1, currentPage - Math.floor(VISIBLE_PAGES / 2));
                let endPage   = Math.min(totalPages, startPage + VISIBLE_PAGES - 1);
                if (endPage - startPage < VISIBLE_PAGES - 1) {
                    startPage = Math.max(1, endPage - VISIBLE_PAGES + 1);
                }
            %>

            <% if (startPage > 1) { %>
                <a href="<%= buildPageUrl(1) %>" class="page-btn">1</a>
                <% if (startPage > 2) { %><span class="page-dots">…</span><% } %>
            <% } %>

            <% for (let p = startPage; p <= endPage; p++) { %>
                <% if (p === currentPage) { %>
                    <span class="page-btn page-btn--active" aria-current="page"><%= p %></span>
                <% } else { %>
                    <a href="<%= buildPageUrl(p) %>" class="page-btn"><%= p %></a>
                <% } %>
            <% } %>

            <% if (endPage < totalPages) { %>
                <% if (endPage < totalPages - 1) { %><span class="page-dots">…</span><% } %>
                <a href="<%= buildPageUrl(totalPages) %>" class="page-btn"><%= totalPages %></a>
            <% } %>

            <!-- Next Button -->
            <% if (currentPage >= totalPages) { %>
                <span class="page-btn page-btn--disabled" aria-disabled="true">
                    Next
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
                </span>
            <% } else { %>
                <a href="<%= buildPageUrl(currentPage + 1) %>" class="page-btn">
                    Next
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            <% } %>

        </nav>
    </div>
</section>
<% } %>

<!-- ═══ FOOTER ═══ -->
<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="footer-brand">
                <h3 class="footer-logo-text">WorkerFinder</h3>
                <p>Connect with trusted and verified professionals in your area. Get your work done quickly and efficiently.</p>
                <div class="social-icons">
                    <a href="#" aria-label="Facebook">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    </a>
                    <a href="#" aria-label="Twitter">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
                    </a>
                    <a href="#" aria-label="Instagram">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                    </a>
                </div>
            </div>
            <div class="footer-section">
                <h4>Resources</h4>
                <ul>
                    <li><a href="#">About Us</a></li>
                    <li><a href="/#services">Our Services</a></li>
                    <li><a href="/workers">Find Workers</a></li>
                    <li><a href="/#contact">Contact Us</a></li>
                </ul>
            </div>

            <div class="footer-section">
                <h4>Social</h4>
                <div class="footer-social-col">
                    <a href="#" class="footer-social-link">Facebook</a>
                    <a href="#" class="footer-social-link">Twitter</a>
                    <a href="#" class="footer-social-link">Instagram</a>
                    <a href="#" class="footer-social-link">YouTube</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>Copyright &copy; 2024 &middot; All rights reserved. | Developed by SP24-BCS-053</p>
        </div>
    </div>
</footer>

<script src="/js/navbar.js"></script>

</body>
</html>
