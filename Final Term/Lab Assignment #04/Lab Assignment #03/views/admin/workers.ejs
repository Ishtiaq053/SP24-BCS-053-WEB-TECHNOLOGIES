<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Workers — WorkerFinder</title>
    <meta name="description" content="Admin panel — manage all workers in WorkerFinder.">
    <link rel="icon" type="image/png" href="/images/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/booking.css">
</head>
<body>

<%- include('../partials/adminNavbar') %>
<%- include('../partials/flash') %>

<div class="admin-wrapper">

    <%- include('../partials/adminSidebar', { activePage: 'workers' }) %>

    <main class="admin-main">

        <header class="admin-header">
            <div>
                <h1 class="admin-page-title">Manage Workers</h1>
                <p class="admin-page-sub">Total: <strong><%= workers.length %></strong> worker<%= workers.length !== 1 ? 's' : '' %> in the database.</p>
            </div>
            <a href="/admin/workers/add" class="btn-admin-add" id="btn-add-worker">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                Add Worker
            </a>
        </header>

        <!-- ── Workers Table ── -->
        <section class="admin-table-section">
            <div class="admin-table-header">
                <h2 class="admin-table-title">All Workers</h2>
                <span class="table-count-badge"><%= workers.length %> total</span>
            </div>

            <div class="admin-table-wrap">
                <table class="admin-table" id="workers-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Photo</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Rate / hr</th>
                            <th>Rating</th>
                            <th>Exp.</th>
                            <th>Jobs</th>
                            <th>Status</th>
                            <th>Verified</th>
                            <th>Discount</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (workers.length === 0) { %>
                            <tr>
                                <td colspan="12" class="table-empty">
                                    No workers yet.
                                    <a href="/admin/workers/add" style="color:var(--green);font-weight:600">Add your first worker →</a>
                                </td>
                            </tr>
                        <% } %>
                        <% workers.forEach(function(worker, i) { %>
                            <tr id="worker-row-<%= worker._id %>">
                                <td class="table-num"><%= i + 1 %></td>
                                <td>
                                    <img
                                        src="<%= worker.image || '/images/avatar-placeholder.png' %>"
                                        alt="<%= worker.name %>"
                                        class="table-thumb"
                                        onerror="this.src='/images/avatar-placeholder.png'"
                                    >
                                </td>
                                <td class="table-name"><%= worker.name %></td>
                                <td><span class="table-category-badge"><%= worker.category %></span></td>
                                <td><%= worker.location %></td>
                                <td class="table-price">PKR <%= worker.price.toLocaleString() %></td>
                                <td><span class="table-rating">★ <%= worker.rating.toFixed(1) %></span></td>
                                <td class="table-exp"><%= worker.experience %>yr</td>
                                <td><%= worker.jobsDone %></td>
                                <td>
                                    <% if (worker.stock === 1) { %>
                                        <span class="status-badge status-badge--available">Available</span>
                                    <% } else { %>
                                        <span class="status-badge status-badge--busy">Busy</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (worker.verified) { %>
                                        <span class="verified-tick" title="Verified">✓</span>
                                    <% } else { %>
                                        <span class="unverified-dash" title="Not verified">–</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (worker.isOnSale) { %>
                                        <span class="discount-badge-admin">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                            <%= worker.discountPercent %>% OFF
                                        </span>
                                    <% } else { %>
                                        <span class="no-discount-dash">—</span>
                                    <% } %>
                                </td>
                                <td class="table-actions">
                                    <a href="/admin/workers/edit/<%= worker._id %>" class="btn-tbl-edit" title="Edit worker" id="edit-<%= worker._id %>">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        Edit
                                    </a>
                                    <button
                                        class="btn-tbl-discount"
                                        title="Manage discount"
                                        id="discount-<%= worker._id %>"
                                        onclick="openDiscountModal('<%= worker._id %>', '<%= worker.name.replace(/'/g, "\\'") %>', <%= worker.isOnSale %>, <%= worker.discountPercent %>)"
                                    >
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                        %
                                    </button>
                                    <button
                                        class="btn-tbl-delete"
                                        title="Delete worker"
                                        id="delete-<%= worker._id %>"
                                        onclick="openDeleteModal('<%= worker._id %>', '<%= worker.name.replace(/'/g, "\\'") %>')"
                                    >
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

<!-- ═══════════════════════════════════════════════════
     DELETE CONFIRMATION MODAL
     ═══════════════════════════════════════════════════ -->
<div id="delete-modal-overlay" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-box" id="delete-modal-box">
        <div class="modal-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
        </div>
        <h2 class="modal-title" id="modal-title">Delete Worker?</h2>
        <p class="modal-desc">
            You are about to permanently delete
            <strong id="modal-worker-name">this worker</strong>.
            This action cannot be undone.
        </p>
        <div class="modal-actions">
            <button class="btn-modal-cancel" id="modal-cancel-btn" onclick="closeDeleteModal()">
                Cancel
            </button>
            <form id="delete-form" method="POST" action="" style="display:inline">
                <button type="submit" class="btn-modal-confirm" id="modal-confirm-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                    Yes, Delete
                </button>
            </form>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     DISCOUNT MANAGEMENT MODAL
     ═══════════════════════════════════════════════════ -->
<div id="discount-modal-overlay" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="dm-modal-title">
    <div class="modal-box discount-modal-box">
        <div class="discount-modal-header">
            <div class="discount-modal-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <div>
                <h2 class="modal-title" id="dm-modal-title" style="margin:0;font-size:17px;">Manage Discount</h2>
                <p id="dm-worker-name" style="margin:0;font-size:13px;color:#64748b;"></p>
            </div>
        </div>

        <!-- Current status strip -->
        <div id="dm-status-strip" class="dm-status-strip"></div>

        <!-- Apply / Update form -->
        <form id="discount-form" method="POST" action="">
            <input type="hidden" name="action" value="apply">
            <div class="dm-field">
                <label for="dm-pct-input" class="dm-label">Discount Percentage <span style="color:#6b7280;font-weight:400;">(1 – 99%)</span></label>
                <div class="dm-input-row">
                    <input
                        type="number"
                        id="dm-pct-input"
                        name="discountPercent"
                        class="booking-input"
                        min="1" max="99" step="1"
                        placeholder="e.g. 20"
                        required
                        style="width:130px;"
                    >
                    <span style="font-size:22px;font-weight:800;color:var(--green);">%</span>
                </div>
                <p id="dm-preview" style="font-size:12px;color:var(--green);margin-top:6px;font-weight:600;"></p>
            </div>
            <div class="dm-actions">
                <button type="button" class="btn-modal-cancel" onclick="closeDiscountModal()">Cancel</button>
                <button type="submit" class="btn-booking-confirm" id="dm-apply-btn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    Apply Discount
                </button>
            </div>
        </form>

        <!-- Remove form -->
        <form id="remove-discount-form" method="POST" action="" style="margin-top:10px;display:none;">
            <input type="hidden" name="action" value="remove">
            <div class="dm-actions" style="justify-content:flex-start;">
                <button type="submit" class="btn-tbl-delete" style="padding:9px 18px;font-size:13px;border-radius:8px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    Remove Discount
                </button>
            </div>
        </form>
    </div>
</div>

<script src="/js/navbar.js"></script>
<script>
/* ── Delete Modal Logic ─────────────────────────────── */
const overlay  = document.getElementById('delete-modal-overlay');
const modalBox = document.getElementById('delete-modal-box');
const nameEl   = document.getElementById('modal-worker-name');
const form     = document.getElementById('delete-form');

function openDeleteModal(id, name) {
    nameEl.textContent = name;
    form.action = `/admin/workers/delete/${id}`;
    overlay.classList.add('modal-visible');
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('modal-cancel-btn').focus(), 100);
}

function closeDeleteModal() {
    overlay.classList.remove('modal-visible');
    document.body.style.overflow = '';
}

overlay.addEventListener('click', e => { if (e.target === overlay) closeDeleteModal(); });
document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && overlay.classList.contains('modal-visible')) closeDeleteModal();
});

/* ── Discount Modal Logic ────────────────────────────── */
const dmOverlay     = document.getElementById('discount-modal-overlay');
const dmForm        = document.getElementById('discount-form');
const rmForm        = document.getElementById('remove-discount-form');
const dmPctInput    = document.getElementById('dm-pct-input');
const dmPreview     = document.getElementById('dm-preview');
const dmStatus      = document.getElementById('dm-status-strip');
const dmApplyBtn    = document.getElementById('dm-apply-btn');
let   dmWorkerPrice = 0;

function openDiscountModal(id, name, isOnSale, currentPct) {
    document.getElementById('dm-worker-name').textContent = name;
    dmForm.action   = `/admin/workers/${id}/discount`;
    rmForm.action   = `/admin/workers/${id}/discount`;
    rmForm.style.display = isOnSale ? 'block' : 'none';

    if (isOnSale) {
        dmStatus.innerHTML = `<span class="discount-badge-admin" style="font-size:13px;padding:5px 12px;">Currently: ${currentPct}% OFF</span>`;
        dmStatus.style.display = 'flex';
        dmPctInput.value = currentPct;
        dmApplyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Update Discount';
    } else {
        dmStatus.innerHTML = '<span style="font-size:12px;color:#64748b;">No active discount.</span>';
        dmStatus.style.display = 'flex';
        dmPctInput.value = '';
        dmApplyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Apply Discount';
    }

    updatePreview();
    dmOverlay.classList.add('modal-visible');
    document.body.style.overflow = 'hidden';
    setTimeout(() => dmPctInput.focus(), 100);
}

function closeDiscountModal() {
    dmOverlay.classList.remove('modal-visible');
    document.body.style.overflow = '';
}

function updatePreview() {
    const pct = parseInt(dmPctInput.value, 10);
    if (!isNaN(pct) && pct >= 1 && pct <= 99) {
        dmPreview.textContent = `Workers with this discount will appear in the On Discount page.`;
    } else {
        dmPreview.textContent = '';
    }
}

dmPctInput.addEventListener('input', updatePreview);
dmOverlay.addEventListener('click', e => { if (e.target === dmOverlay) closeDiscountModal(); });
document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && dmOverlay.classList.contains('modal-visible')) closeDiscountModal();
});
</script>
</body>
</html>
