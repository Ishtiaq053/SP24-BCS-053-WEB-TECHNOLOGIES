<%# ─── ON-DISCOUNT WORKERS PAGE (partial — injected into layouts/main.ejs) ─── %>

<%# ── HERO BANNER — matches workers-hero green theme ── %>
<section class="onsale-hero">
  <div class="onsale-hero-overlay"></div>
  <div class="onsale-hero-content">
    <div class="onsale-hero-badge">🔥 Limited Time Offers</div>
    <h1 class="onsale-hero-title">On-Discount Workers</h1>
    <p class="onsale-hero-sub">
      Discounted skilled workers — book before offers expire.
      <strong><%= totalWorkers %> deal<%= totalWorkers !== 1 ? 's' : '' %> available</strong>
    </p>
  </div>
</section>

<%# ── MAIN CONTENT ── %>
<section class="onsale-section">
  <div class="container">

    <% if (workers.length === 0) { %>

      <div class="empty-state">
        <div class="empty-icon">🏷️</div>
        <h2 class="empty-title">No Active Discounts Right Now</h2>
        <p class="empty-desc">Check back soon — new deals are added regularly.</p>
        <a href="/workers" class="btn-empty-reset">Browse All Workers</a>
      </div>

    <% } else { %>

      <%# Deals count bar — matches results-bar style %>
      <div class="onsale-results-bar">
        <p class="results-info">
          Showing <strong><%= totalWorkers %></strong> discounted deal<%= totalWorkers !== 1 ? 's' : '' %>
        </p>
      </div>

      <%# ALL cards rendered in DOM — jQuery controls visibility %>
      <div id="product-list" class="onsale-grid">
        <% workers.forEach(function(worker) {
          const emojiMap = {
            'Plumbing':'🔧','Electrical':'⚡','Carpentry':'🪚',
            'Painting':'🎨','Cleaning':'🧹','Driving':'🚗',
            'Gardening':'🌿','AC & Repair':'❄️'
          };
          const emoji = emojiMap[worker.category] || '🛠️';
          const isAvailable = worker.stock === 1;
          const fullStars = Math.floor(worker.rating);
          const halfStar  = (worker.rating - fullStars) >= 0.5;
        %>
          <div class="worker-card onsale-card">

            <%# Discount ribbon %>
            <div class="onsale-ribbon"><%= worker.discountPercent %>% OFF</div>

            <%# Card top — same gradient as workers page %>
            <div class="worker-card-top">
              <div class="worker-avatar-wrap">
                <img
                  src="<%= worker.image && worker.image.trim() !== '' ? worker.image : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(worker.name) + '&background=2a7a52&color=fff&size=80&bold=true' %>"
                  alt="<%= worker.name %>"
                  class="worker-avatar"
                  loading="lazy"
                  onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(worker.name) %>&background=2a7a52&color=fff&size=80&bold=true'"
                >
              </div>
              <% if (worker.verified) { %>
                <span class="verified-badge" title="Verified Worker">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                  Verified
                </span>
              <% } %>
              <span class="availability-badge <%= isAvailable ? 'badge--available' : 'badge--busy' %>">
                <span class="badge-dot"></span>
                <%= isAvailable ? 'Available' : 'Busy' %>
              </span>
            </div>

            <%# Card body %>
            <div class="worker-card-body">
              <h3 class="worker-name"><%= worker.name %></h3>
              <p class="worker-category"><%= emoji %> <%= worker.category %></p>

              <%# Stars %>
              <div class="star-rating">
                <% for (let i = 1; i <= 5; i++) { %>
                  <% if (i <= fullStars) { %>
                    <span class="star star--full">★</span>
                  <% } else if (i === fullStars + 1 && halfStar) { %>
                    <span class="star star--half">★</span>
                  <% } else { %>
                    <span class="star star--empty">★</span>
                  <% } %>
                <% } %>
                <span class="rating-value"><%= worker.rating.toFixed(1) %></span>
              </div>

              <%# Meta row %>
              <div class="worker-meta">
                <span class="meta-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  <%= worker.location %>
                </span>
                <span class="meta-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <%= worker.experience %> yrs exp
                </span>
              </div>
            </div>

            <%# Card footer — pricing + CTA %>
            <div class="worker-card-footer onsale-card-footer">
              <div class="onsale-pricing">
                <span class="onsale-price-original">PKR <%= worker.price.toLocaleString() %>/hr</span>
                <span class="onsale-price-discounted">PKR <%= worker.discountedPrice.toLocaleString() %>/hr</span>
              </div>
              <div class="card-footer-btns">
                <button
                  class="btn-view-details"
                  data-name="<%= worker.name %>"
                  data-category="<%= worker.category %>"
                  data-price="<%= worker.discountedPrice %>"
                  data-original-price="<%= worker.price %>"
                  data-location="<%= worker.location %>"
                  data-experience="<%= worker.experience %>"
                  data-jobs="<%= worker.jobsDone %>"
                  data-rating="<%= worker.rating %>"
                  data-desc="<%= (worker.description || '').substring(0,200) %>"
                  data-image="<%= worker.image || '' %>"
                  data-available="<%= isAvailable %>"
                  data-verified="<%= worker.verified %>"
                  data-wid="<%= worker._id %>"
                  onclick="openDetailsModal(this)"
                >Details</button>
                <% if (!isAvailable) { %>
                  <button class="btn-view-profile" disabled title="Currently Busy">Unavailable</button>
                <% } else if (currentUser) { %>
                  <button
                    class="btn-view-profile"
                    onclick="openBookingModal('<%= worker._id %>','<%= worker.name.replace(/'/g, "\\'") %>','<%= worker.category %>',<%= worker.discountedPrice %>)"
                  >Hire Now</button>
                <% } else { %>
                  <a href="/login" class="btn-view-profile btn-view-profile--guest">Login to Book</a>
                <% } %>
              </div>
            </div>

          </div>
        <% }); %>
      </div><%# END #product-list %>

      <%# ── PAGINATION CONTROLS ── %>
      <div class="onsale-pagination" id="paginationControls">
        <button id="prevBtn" class="page-btn" disabled>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
          Prev
        </button>
        <span id="pageIndicator" class="results-page-info">Page <strong>1</strong> of <strong>1</strong></span>
        <button id="nextBtn" class="page-btn">
          Next
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>

    <% } %>
  </div>
</section>

<%# ── WORKER DETAILS MODAL (same as workers page) ── %>
<div id="details-modal-overlay" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="dm-name">
  <div class="modal-box details-modal-box">
    <div class="details-modal-top">
      <button class="details-modal-close" onclick="closeDetailsModal()" aria-label="Close">&times;</button>
      <img id="dm-avatar" class="details-avatar" src="" alt="Worker">
      <div style="display:flex;gap:8px;flex-wrap:wrap;justify-content:center;">
        <span id="dm-verified-badge" class="verified-badge" style="display:none;position:static;">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
          Verified
        </span>
        <span id="dm-avail-badge" class="availability-badge" style="position:static;">
          <span class="badge-dot"></span><span id="dm-avail-text"></span>
        </span>
      </div>
    </div>
    <div class="details-modal-body">
      <h2 id="dm-name" class="details-name"></h2>
      <p id="dm-category" class="details-category"></p>
      <div id="dm-stars" class="star-rating details-stars"></div>
      <div class="details-meta-grid">
        <div class="details-meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span id="dm-location"></span>
        </div>
        <div class="details-meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span id="dm-experience"></span>
        </div>
        <div class="details-meta-item">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          <span id="dm-jobs"></span>
        </div>
      </div>
      <p id="dm-desc" class="details-desc"></p>
    </div>
    <div class="details-modal-footer">
      <div class="worker-price">
        <span id="dm-price-display" class="price-amount"></span>
        <span class="price-unit">/hr</span>
      </div>
      <div id="dm-hire-wrap"></div>
    </div>
  </div>
</div>

<%# ── BOOKING MODAL ── %>
<div id="booking-modal-overlay" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="booking-modal-title">
  <div class="modal-box booking-modal-box">
    <button class="booking-modal-close" onclick="closeBookingModal()" aria-label="Close">&times;</button>

    <div class="booking-modal-header">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <h2 class="modal-title" id="booking-modal-title">Book a Worker</h2>
    </div>

    <div class="booking-worker-summary">
      <p class="booking-worker-name" id="bm-worker-name">—</p>
      <p class="booking-worker-meta">
        <span id="bm-category"></span>
        &nbsp;·&nbsp;
        <strong id="bm-price"></strong>/hr
      </p>
      <span id="bm-avail" class="booking-avail-badge">Available</span>
    </div>

    <form method="POST" action="/bookings/create" id="booking-form">
      <input type="hidden" name="workerId" id="bm-worker-id">
      <input type="hidden" name="bookedPrice" id="bm-booked-price">

      <div class="booking-form-grid">
        <div class="booking-field">
          <label for="bm-date" class="booking-label">Booking Date</label>
          <input type="date" id="bm-date" name="bookingDate" class="booking-input" required>
        </div>
        <div class="booking-field">
          <label for="bm-hours" class="booking-label">Number of Hours <small>(1–24)</small></label>
          <input type="number" id="bm-hours" name="hours" class="booking-input" min="1" max="24" value="2" required>
        </div>
      </div>

      <div class="booking-notes-wrap">
        <div class="booking-field">
          <label for="bm-notes" class="booking-label">Notes <small>(optional)</small></label>
          <textarea id="bm-notes" name="notes" class="booking-input booking-textarea" rows="3" placeholder="Any specific requirements or instructions…"></textarea>
        </div>
      </div>

      <div class="booking-total-row">
        <span class="booking-total-label">Estimated Total</span>
        <span class="booking-total-value" id="bm-total">PKR 0</span>
      </div>

      <div class="booking-modal-actions">
        <button type="button" class="btn-modal-cancel" onclick="closeBookingModal()">Cancel</button>
        <button type="submit" class="btn-booking-confirm">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
          Confirm Booking
        </button>
      </div>
    </form>
  </div>
</div>

<%# ── JQUERY (CDN — only this page) ── %>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<%# ── JQUERY PAGINATION ── %>
<script>
$(document).ready(function () {
  const ITEMS_PER_PAGE = 10;
  let currentPage = 1;
  const $cards    = $('#product-list .worker-card');
  const totalItems  = $cards.length;
  const totalPages  = Math.ceil(totalItems / ITEMS_PER_PAGE) || 1;

  function showPage(page) {
    $cards.hide();
    const start = (page - 1) * ITEMS_PER_PAGE;
    $cards.slice(start, start + ITEMS_PER_PAGE).show();
    $('#pageIndicator').html('Page <strong>' + page + '</strong> of <strong>' + totalPages + '</strong>');
    $('#prevBtn').prop('disabled', page <= 1).toggleClass('page-btn--disabled', page <= 1);
    $('#nextBtn').prop('disabled', page >= totalPages).toggleClass('page-btn--disabled', page >= totalPages);
    if (totalPages <= 1) { $('#paginationControls').hide(); } else { $('#paginationControls').show(); }
    $('html, body').animate({ scrollTop: $('#product-list').offset().top - 80 }, 250);
  }

  $('#nextBtn').on('click', function () { if (currentPage < totalPages) { currentPage++; showPage(currentPage); } });
  $('#prevBtn').on('click', function () { if (currentPage > 1) { currentPage--; showPage(currentPage); } });
  showPage(1);
});
</script>

<%# ── BOOKING MODAL JS — identical to workers.ejs ── %>
<script>
  const bmOverlay = document.getElementById('booking-modal-overlay');
  const bmWorkerIdInput = document.getElementById('bm-worker-id');
  let bmHourlyRate = 0;

  (function setMinDate() {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('bm-date').setAttribute('min', today);
    document.getElementById('bm-date').value = today;
  })();

  function openBookingModal(id, name, category, price) {
    bmHourlyRate = price;
    bmWorkerIdInput.value = id;
    document.getElementById('bm-booked-price').value = price;
    document.getElementById('bm-worker-name').textContent = name;
    document.getElementById('bm-category').textContent   = category;
    document.getElementById('bm-price').textContent      = 'PKR ' + price.toLocaleString();
    updateTotal();
    bmOverlay.classList.add('modal-visible');
    document.body.style.overflow = 'hidden';
  }

  function closeBookingModal() {
    bmOverlay.classList.remove('modal-visible');
    document.body.style.overflow = '';
    document.getElementById('booking-form').reset();
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('bm-date').setAttribute('min', today);
    document.getElementById('bm-date').value = today;
    updateTotal();
  }

  function updateTotal() {
    const hours = parseInt(document.getElementById('bm-hours').value, 10) || 0;
    document.getElementById('bm-total').textContent = 'PKR ' + (bmHourlyRate * hours).toLocaleString();
  }

  document.getElementById('bm-hours').addEventListener('input', updateTotal);
  bmOverlay.addEventListener('click', function(e) { if (e.target === bmOverlay) closeBookingModal(); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && bmOverlay.classList.contains('modal-visible')) closeBookingModal();
  });
  document.getElementById('booking-form').addEventListener('submit', function(e) {
    const hours = parseInt(document.getElementById('bm-hours').value, 10);
    const date  = document.getElementById('bm-date').value;
    const today = new Date().toISOString().split('T')[0];
    if (!date || date < today) { e.preventDefault(); alert('Please select a valid future date.'); return; }
    if (isNaN(hours) || hours < 1 || hours > 24) { e.preventDefault(); alert('Hours must be between 1 and 24.'); return; }
  });
</script>

<script>
// ── Details Modal JS ──
const IS_LOGGED_IN = <%= currentUser ? 'true' : 'false' %>;
const EMOJI_MAP = {'Plumbing':'🔧','Electrical':'⚡','Carpentry':'🪚','Painting':'🎨','Cleaning':'🧹','Driving':'🚗','Gardening':'🌿','AC & Repair':'❄️'};
const dmOverlay = document.getElementById('details-modal-overlay');

function openDetailsModal(btn) {
  const d = btn.dataset;
  const isAvail = d.available === 'true';
  const isVerif = d.verified === 'true';
  const rating  = parseFloat(d.rating);
  const price   = parseFloat(d.price);
  const wid     = d.wid;

  const av = document.getElementById('dm-avatar');
  const fallback = 'https://ui-avatars.com/api/?name=' + encodeURIComponent(d.name) + '&background=2a7a52&color=fff&size=120&bold=true';
  av.src = (d.image && d.image.trim()) ? d.image : fallback;
  av.onerror = () => { av.src = fallback; };

  document.getElementById('dm-verified-badge').style.display = isVerif ? 'inline-flex' : 'none';
  const availBadge = document.getElementById('dm-avail-badge');
  availBadge.className = 'availability-badge ' + (isAvail ? 'badge--available' : 'badge--busy');
  availBadge.style.position = 'static';
  document.getElementById('dm-avail-text').textContent = isAvail ? 'Available' : 'Busy';
  availBadge.querySelector('.badge-dot').style.background = isAvail ? '#22c55e' : '#ef4444';

  document.getElementById('dm-name').textContent = d.name;
  document.getElementById('dm-category').innerHTML = (EMOJI_MAP[d.category] || '🛠️') + ' ' + d.category;

  const full = Math.floor(rating), half = (rating - full) >= 0.5;
  let stars = '';
  for (let i = 1; i <= 5; i++) {
    if (i <= full) stars += '<span class="star star--full">★</span>';
    else if (i === full + 1 && half) stars += '<span class="star star--half">★</span>';
    else stars += '<span class="star star--empty">★</span>';
  }
  stars += '<span class="rating-value">' + rating.toFixed(1) + '</span>';
  document.getElementById('dm-stars').innerHTML = stars;

  document.getElementById('dm-location').textContent   = d.location;
  document.getElementById('dm-experience').textContent = d.experience + ' yrs exp';
  document.getElementById('dm-jobs').textContent       = d.jobs + ' jobs done';
  document.getElementById('dm-desc').textContent       = d.desc || 'No description provided.';
  document.getElementById('dm-price-display').textContent = 'PKR ' + price.toLocaleString();

  const wrap = document.getElementById('dm-hire-wrap');
  if (!isAvail) {
    wrap.innerHTML = '<button class="btn-view-profile" disabled>Unavailable</button>';
  } else if (IS_LOGGED_IN) {
    const safeName = d.name.replace(/'/g, "\\'");
    wrap.innerHTML = '<button class="btn-view-profile" onclick="closeDetailsModal();openBookingModal(\'' + wid + '\',\'' + safeName + '\',\'' + d.category + '\',' + price + ')">Hire This Worker</button>';
  } else {
    wrap.innerHTML = '<a href="/login" class="btn-view-profile">Login to Hire</a>';
  }

  dmOverlay.classList.add('modal-visible');
  document.body.style.overflow = 'hidden';
}

function closeDetailsModal() {
  dmOverlay.classList.remove('modal-visible');
  document.body.style.overflow = '';
}

dmOverlay.addEventListener('click', e => { if (e.target === dmOverlay) closeDetailsModal(); });
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && dmOverlay.classList.contains('modal-visible')) closeDetailsModal();
});
</script>
